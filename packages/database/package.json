{
  "name": "@voxori/database",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:migrate": "supabase migration up --local",
    "db:push": "supabase db push",
    "gen-types": "supabase gen types typescript --local 2>/dev/null > src/types.ts",
    "gen-types:linked": "supabase gen types typescript --linked 2>/dev/null > src/types.ts",
    "supabase:link": "bash ../../scripts/supabase-link-remote.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@supabase/ssr": "^0.6.1",
    "@voxori/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.7.2",
    "supabase": "^1.207.9"
  }
}
