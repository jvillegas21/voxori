# Voxori environment template — copy values into apps/web, apps/api, apps/admin .env.local
# Do NOT commit real secrets. .env.local is gitignored.

# =============================================================================
# Supabase — pick ONE block (local OR production)
# =============================================================================
#
# LOCAL (Docker via `pnpm db:local`):
#   URL is always http://127.0.0.1:54321 — run `pnpm db:sync-env` to write keys.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from pnpm db:status or pnpm db:sync-env>
# SUPABASE_SERVICE_ROLE_KEY=<from pnpm db:status or pnpm db:sync-env>
#
# PRODUCTION (Vercel — cloud project xkkypitkvadiyazgheie):
#   Dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xkkypitkvadiyazgheie.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<cloud anon key>
# SUPABASE_SERVICE_ROLE_KEY=<cloud service_role key — server-only, never NEXT_PUBLIC_*>

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=

# Twilio (voice + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Recommended for Vapi phone import (API key from Twilio Console):
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Platform fallback FROM; tenant active phone_numbers row takes precedence for SMS
TWILIO_PHONE_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional pre-created price IDs (falls back to dynamic price_data from plan tiers)
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PROFESSIONAL_PRICE_ID=

# OpenAI
OPENAI_API_KEY=

# MLS — IDX Broker (primary) + legacy Bridge/Trestle fallbacks
MLS_MARKET=idx_broker_primary
# Per-tenant API keys are stored in integrations.credentials; optional platform defaults:
IDX_BROKER_API_KEY=
# IDX_BROKER_PARTNER_API_KEY=
# IDX_BROKER_ACCOUNT_ID=
# IDX_BROKER_API_BASE_URL=https://api.idxbroker.com
# IDX_BROKER_API_VERSION=1.8.0
# Unlock MLS / ABOR (Bridge RESO API, dataset abor_ref)
BRIDGE_SERVER_TOKEN=
# BRIDGE_CLIENT_ID=
# BRIDGE_CLIENT_SECRET=
# BRIDGE_API_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData
# CTXMLS (Trestle OData RESO API)
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=
# TRESTLE_API_BASE_URL=https://api-trestle.corelogic.com/trestle/odata
# TRESTLE_TOKEN_URL=https://api-trestle.corelogic.com/trestle/oidc/connect/token
# TRESTLE_SCOPE=api

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/integrations/google/callback

# Follow Up Boss CRM (optional API base URL)
FOLLOW_UP_BOSS_API_BASE_URL=https://api.followupboss.com/v1
# Dev-only: fallback when a tenant has not saved a key in the dashboard (/integrations).
# Production tenants must connect via apps/web → Integrations (encrypted per-tenant in DB).
# FOLLOW_UP_BOSS_API_KEY=

# Optional: encrypt integration credentials at rest (falls back to INTERNAL_API_SECRET)
CREDENTIALS_ENCRYPTION_KEY=

# =============================================================================
# App URLs — local vs deployed (no runtime switching; set per environment)
# =============================================================================
#
# LOCAL:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
# API_BASE_URL=http://localhost:3002
#
# PRODUCTION (Vercel — example):
# NEXT_PUBLIC_APP_URL=https://app.voxori.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.voxori.com
# NEXT_PUBLIC_API_BASE_URL=https://api.voxori.com
# API_BASE_URL=https://api.voxori.com
# VOXORI_API_URL=https://api.voxori.com   # optional alias for Vapi tool server URLs

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Admin provisioning (optional — admin app + dev seed)
ADMIN_API_SECRET=
NEXT_PUBLIC_ADMIN_API_SECRET=
# Dev tenant UUID from `pnpm db:seed` when using default dev tenant
NEXT_PUBLIC_DEFAULT_TENANT_ID=

# Internal API (recording migration + inter-service calls)
INTERNAL_API_SECRET=
API_BASE_URL=http://localhost:3002
