# apps/web — copy to .env.local (gitignored). Do NOT commit secrets.

# --- LOCAL Supabase (default for `pnpm dev`) ---
# Run: pnpm db:local (or pnpm dev — predev syncs / auto-starts local Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PRODUCTION (Vercel only — uncomment and use cloud keys) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xkkypitkvadiyazgheie.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
# Production:
# NEXT_PUBLIC_APP_URL=https://app.voxori.com
# NEXT_PUBLIC_API_BASE_URL=https://api.voxori.com

# Dev tenant from pnpm db:seed (optional)
NEXT_PUBLIC_DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111101
