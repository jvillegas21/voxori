# apps/api — copy to .env.local (gitignored). Do NOT commit secrets.

# --- LOCAL Supabase (default for `pnpm dev`) ---
# Run: pnpm db:local (or pnpm dev — predev syncs / auto-starts local Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PRODUCTION (Vercel only — uncomment and use cloud keys) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xkkypitkvadiyazgheie.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_ACCOUNT_SID=your-twilio-account-sid
ADMIN_API_SECRET=your-admin-api-secret
VAPI_API_KEY=your-vapi-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
ELEVENLABS_API_KEY=your-elevenlabs-api-key
INTERNAL_API_SECRET=your-internal-api-secret
# Required for connecting CRM/calendar integrations (Follow Up Boss, Google, etc.).
# Generate: openssl rand -base64 32
# If unset, INTERNAL_API_SECRET is used as fallback (set at least one in apps/api/.env.local).
CREDENTIALS_ENCRYPTION_KEY=

# --- API base URL (Vapi HTTP tools, post-call SMS dispatch, OAuth callbacks) ---
# Local:
API_BASE_URL=http://localhost:3002
# Production (must match public API hostname Vapi can reach):
# API_BASE_URL=https://api.voxori.com
# VOXORI_API_URL=https://api.voxori.com

# Web app URL for OAuth redirects (must match apps/web origin)
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://app.voxori.com

# Google Calendar OAuth (required for calendar onboarding step)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/integrations/google/callback

# MLS — IDX Broker (primary) + legacy Bridge/Trestle
MLS_MARKET=idx_broker_primary
IDX_BROKER_API_KEY=
# IDX_BROKER_PARTNER_API_KEY=
BRIDGE_SERVER_TOKEN=
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=

# Follow Up Boss — per-tenant keys belong in dashboard Integrations (encrypted in DB).
# Optional dev fallback if NODE_ENV is not production and no tenant CRM row exists:
# FOLLOW_UP_BOSS_API_KEY=
# FOLLOW_UP_BOSS_API_BASE_URL=https://api.followupboss.com/v1
